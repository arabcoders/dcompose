#!/bin/sh
set -eu

usage() {
  echo "usage: pre-commit [--unstaged | --all]" >&2
  echo "  (no args)  check staged files" >&2
  echo "  --unstaged check unstaged and untracked files instead" >&2
  echo "  --all      check all tracked files" >&2
}

case "${1:-}" in
  "")
    selected_files=$(git diff --cached --name-only --diff-filter=ACMR)
    mode_label="staged"
    ;;
  --unstaged)
    selected_files=$(git diff --name-only --diff-filter=ACMR)
    selected_files="$selected_files
$(git ls-files --others --exclude-standard)"
    mode_label="unstaged"
    ;;
  --all)
    selected_files=$(git ls-files)
    mode_label="all"
    ;;
  *)
    usage
    exit 1
    ;;
esac

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

TMP_ROOT=${TMPDIR:-/tmp}/tests-dcompose
mkdir -p "$TMP_ROOT"
PIDS_FILE=$(mktemp "$TMP_ROOT/dcompose-precommit.XXXXXX")
trap 'rm -f "$PIDS_FILE"' EXIT

export CI=1
checks_started=0
run_step() {
  local label="$1"
  shift
  checks_started=1
  echo "Starting $label..." >&2
  (
    if ! "$@"; then
      echo "[$label] failed. $mode_label run failed." >&2
      exit 1
    else
      echo "[$label] passed." >&2
    fi
  ) &
  echo $! >>"$PIDS_FILE"
}

run_extra_dir() {
  local scope="$1"
  local dir="$2"
  for step in "$dir"/*; do
    [ -f "$step" ] && [ -x "$step" ] || continue
    run_step "Extra ($scope): $(basename "$step")" "$step"
  done
}

check_go_format() {
  local files
  files=$(gofmt -l cmd internal) || return 1
  if [ -n "$files" ]; then
    printf '%s\n' "$files" >&2
    return 1
  fi
}

echo "Running pre-commit checks ($mode_label)... ${REPO_ROOT}" >&2
go_changed=0
frontend_changed=0

while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in
    cmd/*.go | internal/*.go | go.mod | go.sum | go.work | go.work.sum)
      go_changed=1
      ;;
    .editorconfig | mise.toml)
      go_changed=1
      frontend_changed=1
      ;;
  esac
  case "$path" in
    frontend/*)
      frontend_changed=1
      ;;
  esac
done <<EOF
$selected_files
EOF

if [ "$frontend_changed" -eq 1 ]; then
  echo "Preparing frontend..." >&2
  NODE_ENV=development bun --cwd="$PWD/frontend/" run postinstall --envName=development
  echo "Frontend preparation passed." >&2
fi

if [ "$go_changed" -eq 1 ]; then
  run_step "Go: Formatter" check_go_format
  run_step "Go: Tests" go test -race ./cmd/... ./internal/...
  run_step "Go: Vet" go vet ./cmd/... ./internal/...
fi

if [ "$frontend_changed" -eq 1 ]; then
  run_step "Frontend: Formatter" bun --cwd="$PWD/frontend/" format:check
  run_step "Frontend: Linter" bun --cwd="$PWD/frontend/" lint
  run_step "Frontend: Tests" bun --cwd="$PWD/frontend/" run test
  run_step "Frontend: TSC" bun --cwd="$PWD/frontend/" lint:tsc
fi

extra_dir=$(git rev-parse --git-path hooks)/pre-commit.d
run_extra_dir "Global" "$extra_dir"
if [ "$go_changed" -eq 1 ]; then
  run_extra_dir "Backend" "$extra_dir/backend"
fi
if [ "$frontend_changed" -eq 1 ]; then
  run_extra_dir "Frontend" "$extra_dir/frontend"
fi

if [ "$checks_started" -eq 0 ]; then
  echo "No checks apply to the $mode_label files."
  exit 0
fi

fail=0
while read -r pid; do
  if ! wait "$pid"; then
    fail=1
  fi
done <"$PIDS_FILE"

if [ "$fail" -eq 1 ]; then
  echo "[X] One or more checks failed. $mode_label run failed." >&2
  exit 1
fi

echo "All checks passed."
exit 0
